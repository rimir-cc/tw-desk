{
  "name": "tw-desk",
  "productName": "TW Desk",
  "version": "0.2.4",
  "description": "Small manager for local TiddlyWiki folder wikis",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "local.tw-desk",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TW Desk",
      "artifactName": "TW-Desk-Setup-${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "tiddlywiki": "5.4.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
