{
  "name": "tw-desk",
  "productName": "TW Desk",
  "version": "0.2.18",
  "description": "Small manager for local TiddlyWiki folder wikis",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "local.tw-desk",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "TW Desk link",
        "schemes": [
          "twdesk"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TW Desk",
      "artifactName": "TW-Desk-Setup-${version}.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "artifactName": "TW-Desk-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "TW-Desk-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "tiddlywiki": "5.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
